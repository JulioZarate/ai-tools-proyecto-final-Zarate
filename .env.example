# Variables para scripts/exportar.sh en tu computadora. NO subas el archivo .env real.
VALORIA_EXPORT_URL=https://<tu-instancia>.app.n8n.cloud/webhook/valoria-export
VALORIA_KEY=
# Credenciales que viven SOLO en n8n Cloud / ElevenLabs (referencia por nombre, sin valores):
# ANTHROPIC_API_KEY            -> credencial n8n "Anthropic API (x-api-key)"
# TELEGRAM_BOT_TOKEN           -> credencial n8n "Valoria Telegram Bot"
# VALORIA_WEBHOOK_KEY          -> credencial n8n "Valoria clave webhooks (x-valoria-key)" y secret en ElevenLabs
# ELEVENLABS_AGENT_ID (público) -> atributo data-agent-id en web/index.html
